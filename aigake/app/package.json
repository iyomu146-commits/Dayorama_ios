{
  "name": "dayorama",
  "version": "0.1.0",
  "private": true,
  "description": "Dayorama — 毎日から、小さな町ができていく。",
  "scripts": {
    "build:walk": "node scripts/build-walk.mjs",
    "test:walk": "node --test ../walk/state.test.mjs ../walk/construction.test.mjs ../walk/timelapse.test.mjs ../walk/widget.test.mjs ../walk/debug.test.mjs ../walk/atmosphere.test.mjs ../walk/residents.test.mjs ../walk/completion.test.mjs ../walk/scenery.test.mjs ../experiments/voxel-walk-lab-20260909/stargazing/model.test.mjs scripts/health-bridge.test.mjs",
    "test:studio": "node --test ../experiments/voxel-walk-lab-20260909/town-studio/studio.test.mjs ../experiments/voxel-walk-lab-20260909/town-studio/premium.test.mjs ../experiments/voxel-walk-lab-20260909/town-studio/people.test.mjs",
    "verify:ios": "node scripts/verify-ios.mjs",
    "export:ios": "npm run build:walk && node scripts/export-ios.mjs",
    "sync": "npm run build:walk && cap sync",
    "sync:android": "npm run build:walk && cap sync android",
    "sync:ios": "npm run build:walk && cap sync ios",
    "open:android": "cap open android",
    "open:ios": "cap open ios",
    "run:android": "npm run build:walk && cap run android"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/ios": "^8.4.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "plist": "^5.0.0",
    "xcode": "^3.0.1",
    "yaml": "^2.9.1"
  }
}
