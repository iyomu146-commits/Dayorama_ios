{
  "name": "voxeltown-three-bench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "snapshot": "node tools/snapshot.mjs",
    "dev": "vite --host 127.0.0.1 --port 8531 --strictPort",
    "build": "tsc --noEmit && vite build",
    "test": "tsx --test tests/*.test.ts",
    "sync": "npm run build && cap sync android",
    "android:add": "cap add android"
  },
  "dependencies": {
    "@capacitor/android": "8.4.2",
    "@capacitor/core": "8.4.2",
    "@capacitor/ios": "8.4.2",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.2",
    "@types/node": "24.10.0",
    "@types/three": "0.180.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.1.12"
  }
}
